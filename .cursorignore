# Dependencies & build output (biggest token savings)
web/node_modules/
# Ignore other dist dirs, but NOT web/dist (required by //go:embed in actx0.go)
dist/
!web/dist/
!web/dist/**
.ruff_cache/

# Lock files & generated artifacts
web/package-lock.json
coverage.html
*.out
*.test
*.db

# Binaries & OS junk
actx0
*.exe
*.dll
*.so
*.dylib
.DS_Store

# Local / secret config (agent rarely needs these)
config.prod.yml
config.test.yml
sync/

# Legal & meta docs (low signal for coding tasks)
LICENSE
CODE_OF_CONDUCT.md
CONTRIBUTING.md
SECURITY.md

# Static assets (images rarely help the agent)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.svg
