# DigitalOcean Container Registry image
ACTX0_IMAGE=registry.digitalocean.com/actx0/actx0:main

# Public URL (used in emails, billing redirects, etc.)
ACTX0_SERVER_URL=http://localhost

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=actx0

# Nginx
NGINX_HTTP_PORT=80

# Optional: Sentry error monitoring
# Create Sentry DSN at https://sentry.io
# ACTX0_SENTRY_DSN=

# Optional: AI, mail, billing, OAuth
# Create OpenRouter API key at https://openrouter.ai/keys
# ACTX0_AI_OROUTE_API_KEY=
# Create Resend API key at https://resend.com/api-keys
# ACTX0_RESEND_API_KEY=
# Create Stripe API keys at https://dashboard.stripe.com/apikeys
# ACTX0_STRIPE_SECRET_KEY=
# ACTX0_STRIPE_WEBHOOK_SECRET=
# Create GitHub OAuth App at https://github.com/settings/developers
# ACTX0_GITHUB_OAUTH_CLIENT_ID=
# ACTX0_GITHUB_OAUTH_CLIENT_SECRET=
# ACTX0_GITHUB_OAUTH_REDIRECT_URL=http://localhost/api/v1/public/action/oauth/github/callback
# Create Google OAuth client at https://console.developers.google.com/auth/clients
# ACTX0_GOOGLE_OAUTH_CLIENT_ID=
# ACTX0_GOOGLE_OAUTH_CLIENT_SECRET=
# ACTX0_GOOGLE_OAUTH_REDIRECT_URL=http://localhost/api/v1/public/action/oauth/google/callback
